# Vorlage -- nach .env kopieren und ausfuellen. .env ist gitignored.
#   cp .env.example .env

# Claude-API (fuer Schritt 3: agent.py / LLM-Automatisierung)
ANTHROPIC_API_KEY=

# Absoluter Pfad dieses Projekts AUF DEM HOST (nicht im Container!). Wird
# gebraucht, damit der Webserver ingest.py per "docker run -v ..." als
# Sibling-Container starten kann (Docker-outside-of-Docker) -- der Pfad
# muss aus Host-Sicht stimmen, da der Docker-Daemon Bind-Mounts immer
# gegen den Host aufloest.
HOST_PROJECT_DIR=
