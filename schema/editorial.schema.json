{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://create-teaching-content/editorial.schema.json",
  "title": "editorial.json (Unterrichtseinheit, v2 – Reader-Modell)",
  "description": "Vertrag zwischen dem LLM-Editorial-Schritt und dem deterministischen Typst-Build. Festes, versioniertes Dokument-Modell mit didaktischer Dramaturgie.",
  "type": "object",
  "required": ["schema_version", "meta", "lernziele", "haupttext"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titel", "fach", "stufe"],
      "properties": {
        "titel": { "type": "string", "minLength": 1 },
        "fach": { "type": "string" },
        "stufe": { "type": "string", "description": "z. B. 'Gymnasium 11. Klasse'" },
        "dauer": { "type": "string" },
        "cover_bild": { "type": "string", "description": "Dateiname relativ zum Unit-Ordner (PNG/JPG/SVG)." },
        "cover_zeilen": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
      }
    },

    "lernziele": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kognitiv"],
      "properties": {
        "kognitiv": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "fertigkeiten": { "type": "array", "items": { "type": "string" } },
        "metakognitiv": { "type": "array", "items": { "type": "string" } }
      }
    },

    "lehrerhinweis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "Markdown. Didaktische Begruendung fuer die Lehrkraft." },
        "kernpunkte": { "type": "array", "items": { "type": "string" } }
      }
    },

    "evidenzbasis": {
      "type": "object",
      "description": "Optional. VORSICHT: LLMs erfinden Effektstaerken/Studien. Nur 'geprueft: true' wird ohne Warnhinweis gedruckt.",
      "additionalProperties": false,
      "properties": {
        "prinzipien": { "type": "array", "items": { "type": "string" } },
        "studien": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["studie", "prinzip"],
            "properties": {
              "studie": { "type": "string" },
              "prinzip": { "type": "string" },
              "effektstaerke": { "type": ["string", "number"] },
              "anwendung": { "type": "string" },
              "geprueft": { "type": "boolean" }
            }
          }
        }
      }
    },

    "vorwissen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "description": "Markdown. Aktivierung von Vorwissen (Advance Organizer)." } }
    },

    "einleitung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "description": "Markdown." } }
    },

    "haupttext": {
      "type": "array",
      "minItems": 1,
      "description": "Geordnete Bloecke des Haupttexts.",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["typ", "text"],
            "properties": {
              "typ": { "const": "text" },
              "text": { "type": "string", "description": "Markdown-Fliesstext." }
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["typ", "text"],
            "properties": {
              "typ": { "const": "quelle" },
              "autor": { "type": "string" },
              "titel": { "type": "string" },
              "text": { "type": "string", "description": "Zitat/Quellentext (Markdown)." }
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["typ", "bild", "beschriftung"],
            "properties": {
              "typ": { "const": "figur" },
              "bild": { "type": "string", "description": "Dateiname in units/<unit>/images/." },
              "beschriftung": { "type": "string" },
              "quelle": { "type": "string" },
              "breite": { "type": "string", "description": "z. B. '80%'; Standard '85%'." }
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["typ", "kopf", "zeilen"],
            "properties": {
              "typ": { "const": "tabelle" },
              "beschriftung": { "type": "string" },
              "kopf": { "type": "array", "items": { "type": "string" } },
              "zeilen": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
            }
          }
        ]
      }
    },

    "verstaendnisfragen": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Niederschwellige Fragen direkt zum Text (ohne AFB, ohne Loesung)."
    },

    "aufgaben": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["afb", "text"],
        "properties": {
          "afb": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Anforderungsbereich I-III." },
          "text": { "type": "string" },
          "loesung": { "type": "string", "description": "Erscheint im Loesungs-Anhang, wenn --solutions gesetzt ist." }
        }
      }
    },

    "glossar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["begriff", "definition"],
        "properties": {
          "begriff": { "type": "string" },
          "definition": { "type": "string" }
        }
      }
    },

    "bibliografie": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titel"],
        "properties": {
          "autor": { "type": "string" },
          "titel": { "type": "string" },
          "jahr": { "type": ["string", "integer"] },
          "ort": { "type": "string" },
          "verlag": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },

    "schlagwoerter": { "type": "array", "items": { "type": "string" } }
  }
}
