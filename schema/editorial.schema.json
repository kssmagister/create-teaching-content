{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://create-teaching-content/editorial.schema.json",
  "title": "editorial.json (Unterrichtseinheit)",
  "description": "Vertrag zwischen dem LLM-Editorial-Schritt und dem deterministischen Build. Eine feste, versionierte Struktur -- keine Schema-Drift.",
  "type": "object",
  "required": ["schema_version", "unit_title", "subject", "grade_level", "learning_objectives", "editor_note", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Muss zur build.py-Version passen."
    },
    "unit_title": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "grade_level": { "type": "string", "minLength": 1 },
    "duration": { "type": "string" },
    "learning_objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognitive"],
      "properties": {
        "cognitive": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "skills": { "type": "array", "items": { "type": "string" } },
        "metacognitive": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_base": {
      "type": "object",
      "description": "OPTIONAL und mit Vorsicht zu geniessen: LLMs erfinden Effektstaerken und Zitate. Nur uebernehmen, was du selbst gegengeprueft hast. Siehe README, Abschnitt 'Grenzen'.",
      "additionalProperties": false,
      "properties": {
        "principles": { "type": "array", "items": { "type": "string" } },
        "key_research": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["study", "principle"],
            "properties": {
              "study": { "type": "string" },
              "principle": { "type": "string" },
              "effect_size": { "type": ["string", "number"] },
              "application": { "type": "string" },
              "verified": {
                "type": "boolean",
                "description": "Vom Menschen geprueft? Nur verifizierte Angaben werden im PDF ohne Warnhinweis gedruckt."
              }
            }
          }
        }
      }
    },
    "editor_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "key_takeaways": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cover_lines": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "cover_image": {
      "type": "string",
      "description": "Optional: Dateiname eines Cover-Bilds (PNG/JPG/SVG), relativ zum Unit-Ordner. Fehlt es, nutzt das Cover ein rein typografisches Layout."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_title", "clippings"],
        "properties": {
          "section_title": { "type": "string" },
          "purpose": { "type": "string" },
          "clippings": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Liste von clipping-IDs (aus dem Front-Matter der Dateien in clippings/)."
          }
        }
      }
    },
    "recommended_order": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optionale explizite Reihenfolge der clipping-IDs. Fehlt sie, wird die Section-Reihenfolge verwendet."
    },
    "worksheets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "task"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "task": { "type": "string" },
          "body": { "type": "string", "description": "Markdown. Freiraum-Zeilen mit '___' erzeugen Schreiblinien." },
          "differentiation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "support": { "type": "string" },
              "extension": { "type": "string" }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formative": { "type": "string" },
        "summative": { "type": "string" }
      }
    },
    "materials_needed": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Vollstaendige Quellenangaben. Pflicht fuer Urheberrecht/Zitat."
    }
  }
}
